# backend/.env — kopyala: backend/.env
# (backend/.env repo kökündeki .gitignore'daki `.env*` kuralıyla zaten yok sayılır)

# SQLite dosya yolu. Prod'da kalıcı bir volume'e işaret etmeli, yoksa her
# deploy'da katalog ve elle girilen fiyatlar sıfırlanır.
DATABASE_URL=sqlite:///./autocalc.db

# Frontend origin'leri, virgülle ayrılmış. GitHub Pages origin'ini prod'da ekle.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Admin uçlarını (PUT /api/admin/prices) açar. Boşsa admin router hiç mount edilmez.
ADMIN_TOKEN=

LOG_LEVEL=INFO
